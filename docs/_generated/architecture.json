{
  "product": "orazaka",
  "source": "generated from code by scripts/generate-docs.mjs — do not hand-edit",
  "repositories": [
    {
      "name": "orazaka-build",
      "url": "https://github.com/krizaka/orazaka-build",
      "path": "orazaka-libs/orazaka-build",
      "kind": "maven",
      "layer": "foundation",
      "description": "Parent POM (Spring Boot / Spring AI BOMs, plugin management, Orazaka BOM) and the shared governance test kit (ArchUnit rules, Testcontainers base) for every Orazaka JVM repository.",
      "dependsOn": []
    },
    {
      "name": "orazaka-contracts",
      "url": "https://github.com/krizaka/orazaka-contracts",
      "path": "orazaka-libs/orazaka-contracts",
      "kind": "maven",
      "layer": "foundation",
      "description": "Tier-1 platform contracts shared by every Orazaka service: the job plane (jobs-api) and the application-persistence ports (persistence-app-api). Pure interfaces and records, zero implementation.",
      "dependsOn": [
        "orazaka-build"
      ]
    },
    {
      "name": "orazaka-users",
      "url": "https://github.com/krizaka/orazaka-users",
      "path": "orazaka-apps/services/orazaka-users",
      "kind": "maven",
      "layer": "domain",
      "description": "Reusable user management for any Krizaka application: registration, e-mail verification, login (password + Google/GitHub OAuth), forgot/reset password, profile & preferences, API keys, RBAC and JWT issuance.",
      "dependsOn": [
        "orazaka-build"
      ]
    },
    {
      "name": "orazaka-notifications",
      "url": "https://github.com/krizaka/orazaka-notifications",
      "path": "orazaka-apps/services/orazaka-notifications",
      "kind": "maven",
      "layer": "domain",
      "description": "Channel-based notification delivery for any Krizaka application: e-mail (SMTP), SMS (Twilio) and webhooks behind one DeliveryClient port, driven by platform events (user registered, password reset) or explicit notification requests over AMQP.",
      "dependsOn": [
        "orazaka-build"
      ]
    },
    {
      "name": "orazaka-billing",
      "url": "https://github.com/krizaka/orazaka-billing",
      "path": "orazaka-apps/services/orazaka-billing",
      "kind": "maven",
      "layer": "domain",
      "description": "Credits, wallets, plans, subscriptions, pricebook and metering (hold → settle → release) as a reusable billing service, with its contract (billing-api) and a typed HTTP client (billing-client).",
      "dependsOn": [
        "orazaka-build"
      ]
    },
    {
      "name": "orazaka-studio",
      "url": "https://github.com/krizaka/orazaka-studio",
      "path": "orazaka-apps/services/orazaka-studio",
      "kind": "maven",
      "layer": "ai",
      "description": "Studio & pack marketplace: pack catalogue, studio blueprints, installations and saga-driven runs, with its contract (studio-api) and HTTP client (studio-client).",
      "dependsOn": [
        "orazaka-build",
        "orazaka-contracts",
        "orazaka-billing"
      ]
    },
    {
      "name": "orazaka-ai-engine",
      "url": "https://github.com/krizaka/orazaka-ai-engine",
      "path": "orazaka-libs/orazaka-ai-engine",
      "kind": "maven",
      "layer": "ai",
      "description": "The Orazaka cognitive SDK: AiClient & provider mesh (core), the interceptor pipeline, tools (MCP · RAG · sandbox), use-case orchestration (business), application persistence and asset encryption.",
      "dependsOn": [
        "orazaka-build",
        "orazaka-contracts",
        "orazaka-billing",
        "orazaka-studio"
      ]
    },
    {
      "name": "orazaka-conversation-service",
      "url": "https://github.com/krizaka/orazaka-conversation-service",
      "path": "orazaka-apps/services/orazaka-conversation-service",
      "kind": "maven",
      "layer": "ai",
      "description": "Interactive ingress of the Orazaka engine: chat (SSE streaming), intents, models, pipeline, MCP and job APIs — translates transport into Intentions, never business logic.",
      "dependsOn": [
        "orazaka-build",
        "orazaka-contracts",
        "orazaka-users",
        "orazaka-billing",
        "orazaka-ai-engine"
      ]
    },
    {
      "name": "orazaka-job-service",
      "url": "https://github.com/krizaka/orazaka-job-service",
      "path": "orazaka-apps/services/orazaka-job-service",
      "kind": "maven",
      "layer": "ai",
      "description": "Asynchronous job executor of the Orazaka engine: drains the interactive and batch lanes, owns the capability registry and the worker registry.",
      "dependsOn": [
        "orazaka-build",
        "orazaka-contracts",
        "orazaka-users",
        "orazaka-billing",
        "orazaka-ai-engine"
      ]
    },
    {
      "name": "orazaka-knowledge-service",
      "url": "https://github.com/krizaka/orazaka-knowledge-service",
      "path": "orazaka-apps/services/orazaka-knowledge-service",
      "kind": "maven",
      "layer": "ai",
      "description": "Knowledge & RAG retrieval service (pgvector) with asynchronous indexing.",
      "dependsOn": [
        "orazaka-build"
      ]
    },
    {
      "name": "orazaka-automation-service",
      "url": "https://github.com/krizaka/orazaka-automation-service",
      "path": "orazaka-apps/services/orazaka-automation-service",
      "kind": "maven",
      "layer": "ai",
      "description": "Connector automation (Jira, Slack, WhatsApp, Messenger, CLI agents) with Quartz scheduling and execution telemetry.",
      "dependsOn": [
        "orazaka-build",
        "orazaka-billing"
      ]
    },
    {
      "name": "orazaka-edge",
      "url": "https://github.com/krizaka/orazaka-edge",
      "path": "orazaka-apps/services/orazaka-edge",
      "kind": "maven",
      "layer": "foundation",
      "description": "Transparent HTTP edge in front of every Orazaka service: routing, API-key → JWT exchange, CORS and tracing. Spring MVC + virtual threads.",
      "dependsOn": [
        "orazaka-build"
      ]
    },
    {
      "name": "orazaka-worker-media",
      "url": "https://github.com/krizaka/orazaka-worker-media",
      "path": "orazaka-apps/workers/orazaka-worker-media",
      "kind": "python",
      "layer": "worker",
      "description": "Native (Metal) Python worker for image/video generation and media composition, speaking the Orazaka AMQP worker protocol.",
      "dependsOn": []
    },
    {
      "name": "orazaka-ui-kit",
      "url": "https://github.com/krizaka/orazaka-ui-kit",
      "path": "orazaka-apps/ui/orazaka-ui-kit",
      "kind": "npm",
      "layer": "foundation",
      "description": "@krizaka/orazaka-shared (TypeScript types, Zod schemas, design tokens) and @krizaka/orazaka-design-system (React components, Tailwind preset, theme, icon registry) for Next.js and React Native apps.",
      "dependsOn": []
    },
    {
      "name": "orazaka-web-client",
      "url": "https://github.com/krizaka/orazaka-web-client",
      "path": "orazaka-apps/ui/orazaka-web-client",
      "kind": "npm",
      "layer": "app",
      "description": "Next.js (App Router) client of the Orazaka platform with its mandatory BFF.",
      "dependsOn": [
        "orazaka-ui-kit"
      ]
    },
    {
      "name": "orazaka-web-admin",
      "url": "https://github.com/krizaka/orazaka-web-admin",
      "path": "orazaka-apps/ui/orazaka-web-admin",
      "kind": "npm",
      "layer": "app",
      "description": "Next.js SecOps & administration console of the Orazaka platform.",
      "dependsOn": [
        "orazaka-ui-kit"
      ]
    },
    {
      "name": "orazaka-mobile-client",
      "url": "https://github.com/krizaka/orazaka-mobile-client",
      "path": "orazaka-apps/ui/orazaka-mobile-client",
      "kind": "npm",
      "layer": "app",
      "description": "Expo / React Native client of the Orazaka platform (talks to the edge with Bearer tokens).",
      "dependsOn": [
        "orazaka-ui-kit"
      ]
    },
    {
      "name": "orazaka-cli",
      "url": "https://github.com/krizaka/orazaka-cli",
      "path": "orazaka-apps/ui/orazaka-cli",
      "kind": "npm",
      "layer": "app",
      "description": "The `orazaka` developer CLI: install, start, dev, test, docs and pack tooling for the Orazaka workspace, with an offline SQLite queue.",
      "dependsOn": []
    },
    {
      "name": "orazaka-packs",
      "url": "https://github.com/krizaka/orazaka-packs",
      "path": "orazaka-packs",
      "kind": "packs",
      "layer": "content",
      "description": "Reference packs for the Orazaka Studio marketplace (document validation, media, prospection, real-estate, wellbeing…) and the pack manifest schema.",
      "dependsOn": []
    }
  ],
